rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Config: public read (API keys are rate-limited, not secret)
    match /config/{docId} {
      allow read: if true;
      allow write: if false; // Admin-only
    }

    // Stories: public read, authenticated users can create community stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.isCommunityStory == true
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if false; // Admin-only
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['plays', 'rating', 'ratingCount', 'lastPlayedAt', 'lastRatedAt', 'lastReview']);
    }

    // Pre-built home feed + taxonomy: public read, admin-only write.
    match /feed/{docId}      { allow read: if true; allow write: if false; }
    match /verticals/{id}    { allow read: if true; allow write: if false; }
    match /collections/{id}  { allow read: if true; allow write: if false; }

    // User profile: OWNER only (fixes previous public-read of emails).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    // Owner-only per-user subcollections.
    match /users/{userId}/favorites/{storyId} { allow read, write: if isOwner(userId); }
    match /users/{userId}/progress/{storyId}  { allow read, write: if isOwner(userId); }
    match /users/{userId}/downloads/{storyId} { allow read, write: if isOwner(userId); }
    match /users/{userId}/push_tokens/{tokenId} { allow read, write: if isOwner(userId); }

    // Push tokens — authenticated users can read/write their own
    match /push_tokens/{tokenId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == path.to('/push_tokens/{tokenId}').split('_')[0];
    }
    match /users/{userId}/push_tokens/{tokenId} { allow read, write: if isOwner(userId); }

    // Deleted users archive — owner can create (archive), admin-only read/delete.
    match /deleted_users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if false;
    }

    // Push tokens collection — authenticated users can manage their own tokens
    match /push_tokens/{tokenId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // Admin-only collections (written by the pipeline via the Admin SDK).
    match /user_activity/{docId}   { allow read, write: if false; }
    match /generation_logs/{docId} { allow read, write: if false; }

    // Notifications: authenticated users can read, update, delete
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Allow users to create notifications (for community stories)
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Failed slots: admin-only (internal tracking)
    match /failed_slots/{dateId} {
      allow read, write: if false;
    }
  }
}
