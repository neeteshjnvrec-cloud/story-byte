# StoryByte Environment Configuration

# Firebase (get from Project Settings -> General -> Web API)
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=storybyte-76716.firebaseapp.com
FIREBASE_PROJECT_ID=storybyte-76716
FIREBASE_STORAGE_BUCKET=storybyte-76716.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id-here
FIREBASE_PRIVATE_KEY=your-firebase-admin-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@storybyte-76716.iam.gserviceaccount.com

# Groq LLM (free tier at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud TTS (service account JSON file)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# API
API_BASE_URL=https://us-central1-storybyte-76716.cloudfunctions.net
CDN_URL=https://storage.googleapis.com/storybyte-76716.appspot.com/

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*