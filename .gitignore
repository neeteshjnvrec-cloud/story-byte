# Local Instagram carousel design previews (scripts/preview-carousel.js)
/.carousel-preview/

# Landscape episode videos are over GitHub's 100MB file limit; the workflow
# keeps each one as a 1-day run artifact instead (YouTube/Facebook hold the
# published copies).
/public/episodes/**/*.mp4

# Remake Short outputs (scripts/remake-short.js) — a run artifact, never committed
/remakes/

# Deity Portraits candidates (scripts/deity-portraits.js) — a run artifact, never committed
/deity-candidates/

# Posting media: Instagram/Facebook fetch these from Hosting during the run
# that makes them, then keep their own copies. Never needed again.
/public/instagram/
# Episode audio and scene art: only used to render the video, which YouTube
# and Facebook keep. The app gets the episode's text and YouTube link.
/public/episodes/**/scene-*.jpg
/public/episodes/**/audio.mp3
/public/episodes/**/cover.jpg
/test_models.js
/test_bundle.js
test_models.js
test_bundle.js
