{
  "firestore": {
    "rules": "firestore/firestore.rules.json",
    "indexes": "firestore/firestore-indexes.json",
    "target": "storybyte-76716"
  },
  "storage": {
    "rules": "storage.rules",
    "service": "storybyte-76716"
  },
  "hosting": {
    "site": "storybyte-76716",
    "public": "public",
    "cleanUrls": true,
    "redirects": [
      { "source": "/whatsapp", "destination": "https://whatsapp.com/channel/0029VbEOIuxAojZ0Wgg11J2l", "type": 302 },
      { "source": "/telegram", "destination": "https://t.me/storybytes", "type": 302 },
      { "source": "/app", "destination": "https://play.google.com/store/apps/details?id=com.storybyte.app&referrer=utm_source%3Dshortlink%26utm_medium%3Dsocial%26utm_campaign%3Dshortlink", "type": 302 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "episodes/**/*.mp4",
      "episodes/**/scene-*.jpg",
      "episodes/**/audio.mp3",
      "episodes/life-of-jesus/**"
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/scripts/check-hosting-deploy.js\"",
      "node \"$PROJECT_DIR/scripts/build-site-index.js\""
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "localhost"
    },
    "firestore": {
      "port": 8080,
      "host": "localhost"
    },
    "storage": {
      "port": 9199,
      "host": "localhost"
    },
    "ui": {
      "enabled": true
    }
  }
}
